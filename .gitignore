# Artifacts produced by the loop driver (plots and scratch stay ignored, but
# the CSVs cited as evidence by FABLE.md and the submission docs are tracked —
# a clone must be able to recompute the quoted numbers from committed sources)
artifacts/*
!artifacts/clue_frontier.csv
!artifacts/clue_frontier_scm.csv
!artifacts/seed_sweep.csv
!artifacts/seed_sweep_25.csv
!artifacts/severity_curve.csv
!artifacts/paired_significance.csv
!artifacts/run_sweep_25_driver.py
!artifacts/exploration_frontier.csv
!artifacts/feedback_generations.csv

